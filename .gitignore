# ============================================================
# POWDER Web -- build artifacts (all regenerated by scripts/build.sh).
# The committed engine/ tree therefore stays equal to the upstream POWDER
# 1.18 source plus only the port additions (port/emscripten/, the guarded
# port/sdl/hamfake.cpp). CI rebuilds everything below from scratch.
# ============================================================

# Compiled objects
*.o

# Final WebAssembly build outputs
*.wasm
engine/port/emscripten/powder.js
web/powder.js

# Native host support-tool executables (built from engine/support/*)
engine/support/bmp2c/bmp2c
engine/support/map2c/map2c
engine/support/tile2c/tile2c
engine/support/txt2c/txt2c
engine/support/enummaker/enummaker
engine/support/encyclopedia2c/encyclopedia2c
engine/support/builddpdf/builddpdf
engine/support/compendium/compendium
engine/support/splicebmp/splicebmp

# Source generated at build time by the support tools
engine/glbdef.cpp
engine/glbdef.h
engine/license.cpp
engine/credits.cpp
engine/encyclopedia.cpp
engine/encyclopedia.h
engine/rooms/*.cpp
engine/rooms/allrooms.h
engine/gfx/*.c
engine/gfx/**/*.c
engine/gfx/akoi3x/sprite16_3x.bmp
libstdc++.a

# OS / editor cruft
.DS_Store
